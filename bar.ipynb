    "import matplotlib.pyplot as plt\n",
    "\n",
    "students = ['Alice', 'Bob', 'Charlie', 'David', 'Eva']\n",
    "marks = [85, 92, 70, 90, 50]\n",
    "\n",
    "plt.bar(students, marks , color= \"orange\" , edgecolor= \"black\" , width = 0.4)\n",
    "plt.xlabel('Students')\n",
    "plt.ylabel('Marks')\n",
    "plt.title('Student Marks')\n",
    "plt.show()"
   ]
  }
